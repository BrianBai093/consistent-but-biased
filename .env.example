OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_CRITICAL_MODEL=gpt-5.6-sol
OPENAI_IMAGE_DETAIL=original

# DeepSeek provider: default for the terra text roles.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# "max" sends reasoning_effort=max; "off" disables thinking entirely.
DEEPSEEK_THINKING=max
DEEPSEEK_TIMEOUT_SECONDS=300
DEEPSEEK_MAX_RETRIES=3

# Provider routing for the terra roles. Text roles (case summary, moderator,
# four text specialists) default to DeepSeek. Image roles (document
# transcription, radiologist) default to OpenAI because the stock DeepSeek
# endpoint is text-only; point IMAGE_PROVIDER=deepseek only at a vision-capable
# OpenAI-compatible endpoint.
TEXT_PROVIDER=deepseek
IMAGE_PROVIDER=openai

MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=3
DOCUMENT_TIMEOUT_SECONDS=180
OCR_MODEL_DIR=models/ocr
OCR_LOW_CONFIDENCE_THRESHOLD=0.95
PAGE_SLICE_MAX_HEIGHT=2400
PAGE_SLICE_MIN_BLANK_RUN=8
DOCUMENT_PREVIOUS_PAGE_TAIL_CHARS=1200
RADIOLOGY_TIMEOUT_SECONDS=300
RADIOLOGY_MAX_RETRIES=1
RADIOLOGY_BATCH_MAX_IMAGES=4
RADIOLOGY_BATCH_MAX_BYTES=12582912
RADIOLOGY_BATCH_CONCURRENCY=2
RADIOLOGY_CACHE_ENABLED=true
RADIOLOGY_CACHE_DIR=.data/radiology-cache
BASELINE_STORE_ENABLED=true
BASELINE_STORE_DIR=.data/baselines
CRITICAL_TIMEOUT_SECONDS=300
CRITICAL_MAX_RETRIES=1
CHECKPOINT_DB_PATH=.data/checkpoints.sqlite3
RUN_STORE_DB_PATH=.data/runs.sqlite3
UPLOAD_DIR=.data/uploads
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=20971520
MAX_IMAGES_PER_CASE=50
SSE_HEARTBEAT_SECONDS=15
MAX_ADDITIONAL_INPUT_CHARS=20000
